# Core model layer
OPENAI_API_KEY=
AEROS_MODEL=gpt-6.1-sol

# Operator system adapter (Pilotbase / Flight Schedule Pro)
FSP_API_KEY=
FSP_OPERATOR_ID=

# Optional higher-fidelity aircraft tracking source
FLIGHTRACKER_PRO_API_KEY=

# Existing Supabase application data layer
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Notes:
# - AviationWeather.gov and OpenSky currently do not require keys in Aeros.
# - FAA NOTAM/NMS production access requires separate FAA onboarding and is intentionally
#   not represented as a fake environment variable until an approved credential flow exists.
# - Keep all secret values server-side and out of git. Copy this file to .env.local locally.
